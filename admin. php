<!-- ===== SCRIPT DE COMPRESSION D'IMAGE ===== -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // ===== CONFIGURATION DE COMPRESSION =====
    const MAX_WIDTH = 800;
    const MAX_HEIGHT = 800;
    const QUALITE = 0.80; // 80% de qualité
    
    // ===== FONCTION DE COMPRESSION =====
    function compressImage(file, callback) {
        if (!file || !file.type.startsWith('image/')) {
            callback(null, 'Veuillez sélectionner une image valide.');
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(event) {
            const img = new Image();
            img.onload = function() {
                // Calculer les nouvelles dimensions
                let width = img.width;
                let height = img.height;
                
                if (width > MAX_WIDTH) {
                    height = (MAX_WIDTH / width) * height;
                    width = MAX_WIDTH;
                }
                if (height > MAX_HEIGHT) {
                    width = (MAX_HEIGHT / height) * width;
                    height = MAX_HEIGHT;
                }
                
                // Créer le canvas
                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                
                // Compresser en JPEG
                const compressedDataUrl = canvas.toDataURL('image/jpeg', QUALITE);
                callback(compressedDataUrl, null);
            };
            img.src = event.target.result;
        };
        reader.onerror = function() {
            callback(null, 'Erreur de lecture du fichier.');
        };
        reader.readAsDataURL(file);
    }
    
    // ===== GESTIONNAIRE POUR LE FORMULAIRE D'AJOUT =====
    const imageInput = document.getElementById('imageInput');
    const compressLoader = document.getElementById('compressLoader');
    const imagePreview = document.getElementById('imagePreview');
    const imageCompressed = document.getElementById('imageCompressed');
    const imageError = document.getElementById('imageError');
    const formAjout = document.getElementById('formAjoutProduit');
    
    if (imageInput) {
        imageInput.addEventListener('change', function() {
            const file = this.files[0];
            imageError.classList.remove('active');
            imagePreview.classList.remove('active');
            
            if (!file) {
                imageCompressed.value = '';
                return;
            }
            
            if (!file.type.startsWith('image/')) {
                imageError.textContent = '⚠️ Veuillez sélectionner une image valide (JPG, PNG, GIF).';
                imageError.classList.add('active');
                this.value = '';
                imageCompressed.value = '';
                return;
            }
            
            // Afficher le loader
            compressLoader.classList.add('active');
            
            compressImage(file, function(compressedDataUrl, erreur) {
                compressLoader.classList.remove('active');
                
                if (erreur) {
                    imageError.textContent = '⚠️ ' + erreur;
                    imageError.classList.add('active');
                    imageCompressed.value = '';
                    return;
                }
                
                // Afficher l'aperçu
                imagePreview.src = compressedDataUrl;
                imagePreview.classList.add('active');
                
                // Stocker l'image compressée
                imageCompressed.value = compressedDataUrl;
            });
        });
    }
    
    // ===== GESTIONNAIRE POUR LE FORMULAIRE DE MODIFICATION =====
    const imageInputModif = document.getElementById('imageInputModif');
    const compressLoaderModif = document.getElementById('compressLoaderModif');
    const imagePreviewModif = document.getElementById('imagePreviewModif');
    const imageCompressedModif = document.getElementById('imageCompressedModif');
    const formModif = document.getElementById('formModifProduit');
    
    if (imageInputModif) {
        imageInputModif.addEventListener('change', function() {
            const file = this.files[0];
            imagePreviewModif.classList.remove('active');
            
            if (!file) {
                imageCompressedModif.value = '';
                return;
            }
            
            if (!file.type.startsWith('image/')) {
                alert('Veuillez sélectionner une image valide.');
                this.value = '';
                imageCompressedModif.value = '';
                return;
            }
            
            // Afficher le loader
            compressLoaderModif.classList.add('active');
            
            compressImage(file, function(compressedDataUrl, erreur) {
                compressLoaderModif.classList.remove('active');
                
                if (erreur) {
                    alert('Erreur de compression : ' + erreur);
                    imageCompressedModif.value = '';
                    return;
                }
                
                // Afficher l'aperçu
                imagePreviewModif.src = compressedDataUrl;
                imagePreviewModif.classList.add('active');
                
                // Stocker l'image compressée
                imageCompressedModif.value = compressedDataUrl;
            });
        });
    }
    
    // ===== VALIDATION AVANT ENVOI DU FORMULAIRE D'AJOUT =====
    if (formAjout) {
        formAjout.addEventListener('submit', function(e) {
            // Si une image a été sélectionnée mais pas encore compressée
            const fileInput = document.getElementById('imageInput');
            if (fileInput && fileInput.files.length > 0 && !imageCompressed.value) {
                e.preventDefault();
                alert('Veuillez attendre que l\'image soit compressée avant d\'ajouter le produit.');
                return false;
            }
            
            // Si aucun fichier sélectionné
            if (fileInput && fileInput.files.length === 0 && !imageCompressed.value) {
                e.preventDefault();
                alert('Veuillez sélectionner une image.');
                return false;
            }
        });
    }
    
    // ===== VALIDATION AVANT ENVOI DU FORMULAIRE DE MODIFICATION =====
    if (formModif) {
        formModif.addEventListener('submit', function(e) {
            const fileInput = document.getElementById('imageInputModif');
            // Si un fichier a été sélectionné mais pas encore compressé
            if (fileInput && fileInput.files.length > 0 && !imageCompressedModif.value) {
                e.preventDefault();
                alert('Veuillez attendre que l\'image soit compressée avant de modifier le produit.');
                return false;
            }
        });
    }
});
</script>

